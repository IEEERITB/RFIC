# To send real emails automatically upon registration, you need a Resend API key.
# 1. Go to https://resend.com and create a free account
# 2. Go to API Keys and generate a new key
# 3. Rename this file from .env.example to .env
# 4. Paste your key below:
RESEND_API_KEY=re_your_api_key_here

# PostgreSQL Database connection string for Prisma ORM (e.g. Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# For the Admin Dashboard (http://localhost:3000/admin)
# You can change the default username and password here:
ADMIN_USERNAME=yug
ADMIN_PASSWORD=12345678
